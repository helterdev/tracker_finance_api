# Environment
ENVIRONMENT=development

# PostgreSQL (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tracker_finance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database URL (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tracker_finance

# Security
SECRET_KEY=change-this-secret-key-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
